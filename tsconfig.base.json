{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@proofline/canonical": ["packages/canonical/src/index.ts"],
      "@proofline/domain": ["packages/domain/src/index.ts"],
      "@proofline/authz": ["packages/authz/src/index.ts"],
      "@proofline/buzz-adapter": ["packages/buzz-adapter/src/index.ts"],
      "next/server": ["apps/web/node_modules/next/server.d.ts"]
    }
  }
}
