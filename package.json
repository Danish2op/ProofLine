{
  "name": "proofline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --passWithNoTests tests/e2e",
    "db:verify": "node --experimental-strip-types scripts/verify-supabase-db.ts",
    "buzz:smoke": "node --experimental-strip-types scripts/buzz-smoke.ts",
    "build": "pnpm -r --if-present run build",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "devDependencies": {
    "@proofline/agents": "workspace:*",
    "@noble/curves": "2.0.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.21.0",
    "eslint": "^9.22.0",
    "next": "15.5.23",
    "pg": "^8.23.0",
    "prettier": "^3.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
